# System
PUID=1000
PGID=1000
TZ=Europe/London

# Storage - path on the host to mount into riven and jellyfin containers
RIVEN_STORAGE_PATH=/path/to/riven-storage

# Domain
# The public origin browsers reach riven at. Passkeys derive their
# relying-party ID from this hostname and are permanently bound to it, so
# changing it later invalidates every registered passkey.
ORIGIN=https://riven.example.com
RIVEN_SETTING__PUBLIC_URL=https://riven.example.com

# Auth — riven refuses to start without both of these.
# Authenticates machine callers (Overseerr/Jellyseerr webhooks) and derives the
# Stremio addon token.
# Generate with: openssl rand -hex 32
RIVEN_SETTING__API_KEY=your-api-key-here
# Signs session tokens. Minimum 32 characters; rotating it signs everyone out.
# Generate with: openssl rand -hex 32
RIVEN_SETTING__AUTH_SECRET=your-auth-secret-here

# Optional: sign in via PocketID, Authelia, Keycloak, or any other OIDC
# provider. JSON array, one entry per provider. See README.md#oidc-sign-in.
# Register this exact redirect URI on the provider's OAuth client:
#   {RIVEN_SETTING__PUBLIC_URL}/auth/callback/{id}
#
# "trust_unverified_email": true is only safe for a provider whose every
# account you vetted yourself (e.g. a self-hosted IdP with no
# self-registration) — without it, PocketID logins will fail with
# account_not_linked, since PocketID has no email confirmation flow and never
# reports the address verified. See the warning in README.md#oidc-sign-in
# before enabling it.
# RIVEN_SETTING__OIDC_PROVIDERS=[{"id":"pocketid","name":"PocketID","issuer":"https://pocketid.example.com","client_id":"your-client-id","client_secret":"your-client-secret","trust_unverified_email":true}]

# Postgres
POSTGRES_USER=riven
POSTGRES_PASSWORD=riven
POSTGRES_DB=riven

# Riven settings
RIVEN_SETTING__DATABASE_URL=postgresql://riven:riven@postgres/riven
RIVEN_SETTING__REDIS_URL=redis://redis:6379
RIVEN_SETTING__GQL_PORT=8080
RIVEN_SETTING__LOG_LEVEL=debug
# Comma-separated CORS origins. Leave empty for permissive (dev only). It also defaults to ORIGIN if blank.
RIVEN_SETTING__CORS_ALLOWED_ORIGINS=https://riven.example.com

# Plugin settings - Seerr
RIVEN_PLUGIN_SETTING__SEERR__APIKEY=
RIVEN_PLUGIN_SETTING__SEERR__URL=
RIVEN_PLUGIN_SETTING__SEERR__FILTER=approved

# Plugin settings - TMDB
RIVEN_PLUGIN_SETTING__TMDB__APIKEY=your-tmdb-api-key

# Plugin settings - TVDB
RIVEN_PLUGIN_SETTING__TVDB__APIKEY=your-tvdb-api-key

# Plugin settings - Debrid (pick one)
RIVEN_PLUGIN_SETTING__STREMTHRU__REALDEBRIDAPIKEY=

# StremThru host entry for extra_hosts (hostname:ip)
STREMTHRU_HOST_ENTRY=stremthru.example.com:1.2.3.4

# Plugin settings - Plex (optional)
PLEX_TOKEN=
PLEX_URL=

# Plugin settings - Notifications (optional, JSON array)
# Discord: discord://webhookId/webhookToken
# JSON webhook: json://host/path or jsons://host/path
RIVEN_PLUGIN_SETTING__NOTIFICATIONS__URLS=[]
