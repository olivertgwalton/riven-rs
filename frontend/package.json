{
	"name": "riven-frontend",
	"private": true,
	"version": "1.0.0-beta.3",
	"type": "module",
	"packageManager": "pnpm@11.6.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"codegen": "graphql-codegen --config codegen.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome lint src vite.config.ts codegen.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/merriweather": "^5.3.0",
		"@fontsource/oxanium": "^5.3.0",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/typescript": "^6.1.2",
		"@lucide/svelte": "^1.56.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-shape": "^3.2.0",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"layerchart": "2.7.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"d3-shape": "^3.2.0",
		"graphql-ws": "^6.3.0",
		"mode-watcher": "^1.1.0",
		"zod": "^4.6.7"
	}
}
