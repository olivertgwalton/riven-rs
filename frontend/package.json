        "@graphql-codegen/typescript": "^6.1.0",
        "@lucide/svelte": "^1.18.0",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.65.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
